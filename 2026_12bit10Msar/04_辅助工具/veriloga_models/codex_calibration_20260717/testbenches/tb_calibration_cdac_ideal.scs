// Real frozen CDAC and SWITCH with an ideal clocked comparator.
simulator lang=spectre
global 0
parameters vdd=1.8 C=4f

subckt CDAC_0716 BITD\<1\> BITD\<2\> BITD\<3\> BITD\<4\> BITD\<5\> \
        BITD\<6\> BITD\<7\> BITD\<8\> BITD\<9\> BITD\<10\> BITD\<11\> \
        BITD\<12\> BITD\<13\> BITU\<1\> BITU\<2\> BITU\<3\> BITU\<4\> \
        BITU\<5\> BITU\<6\> BITU\<7\> BITU\<8\> BITU\<9\> BITU\<10\> \
        BITU\<11\> BITU\<12\> BITU\<13\> N P
    C153 (N BITU\<8\>) capacitor c=C
    C154 (N BITU\<12\>) capacitor c=8.00545*C
    C155 (N BITU\<11\>) capacitor c=4*C
    C156 (N BITU\<13\>) capacitor c=16.0365*C
    C157 (net4 BITU\<4\>) capacitor c=6*C
    C249 (N BITU\<9\>) capacitor c=2*C
    C248 (P BITD\<9\>) capacitor c=2*C
    C152 (N BITU\<10\>) capacitor c=2*C
    C141 (P BITD\<12\>) capacitor c=8*C
    C149 (net4 BITU\<5\>) capacitor c=10*C
    C144 (net3 P) capacitor c=C
    C147 (net4 BITU\<2\>) capacitor c=2*C
    C143 (P BITD\<13\>) capacitor c=16.054213*C
    C146 (net4 BITU\<1\>) capacitor c=C
    C139 (P BITD\<10\>) capacitor c=2*C
    C151 (net4 BITU\<7\>) capacitor c=24*C
    C138 (net3 BITD\<7\>) capacitor c=24*C
    C150 (net4 BITU\<6\>) capacitor c=16*C
    C145 (net4 N) capacitor c=C
    C142 (P BITD\<11\>) capacitor c=4*C
    C148 (net4 BITU\<3\>) capacitor c=4*C
    C140 (P BITD\<8\>) capacitor c=C
    C136 (net3 BITD\<5\>) capacitor c=10*C
    C137 (net3 BITD\<6\>) capacitor c=16*C
    C132 (net3 BITD\<4\>) capacitor c=6*C
    C135 (net3 BITD\<3\>) capacitor c=4*C
    C134 (net3 BITD\<2\>) capacitor c=2*C
    C133 (net3 BITD\<1\>) capacitor c=C
ends CDAC_0716

VAGND (AGND 0) vsource dc=0 type=dc
VDGND (DGND 0) vsource dc=0 type=dc
VAVDD (AVDD AGND) vsource dc=vdd type=dc
VDVDD (DVDD DGND) vsource dc=vdd type=dc
VVCM (VCM AGND) vsource dc=vdd/2 type=dc
VREFP_SRC (VREFP AGND) vsource dc=vdd type=dc
VREFN_SRC (VREFN AGND) vsource dc=0 type=dc
VVIP (VIP AGND) vsource dc=vdd/2 type=dc
VVIN (VIN AGND) vsource dc=vdd/2 type=dc
VRST (RST AGND) vsource type=pulse val0=0 val1=vdd period=100n delay=100p rise=10p fall=10p width=18n
VRST1 (RST1 AGND) vsource type=pulse val0=0 val1=vdd period=100n delay=100p rise=10p fall=10p width=14n
VCALRST (CAL_RST DGND) vsource type=pulse val0=0 val1=vdd period=150u delay=1n rise=10p fall=10p width=2n
VCALCLK (CAL_CLK DGND) vsource type=pulse val0=0 val1=vdd period=10n delay=10p rise=10p fall=10p width=5n
VSOUT (SOUT DGND) vsource dc=0 type=dc
