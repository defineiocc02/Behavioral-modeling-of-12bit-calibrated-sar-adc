VCALD10 (BITD_CAL10 AGND) vsource dc=0 type=dc
VCALD11 (BITD_CAL11 AGND) vsource dc=0 type=dc
VCALD12 (BITD_CAL12 AGND) vsource dc=0 type=dc
VCALU0 (BITU_CAL0 AGND) vsource dc=0 type=dc
VCALU1 (BITU_CAL1 AGND) vsource dc=0 type=dc
VCALU2 (BITU_CAL2 AGND) vsource dc=0 type=dc
VCALU3 (BITU_CAL3 AGND) vsource dc=0 type=dc
VCALU4 (BITU_CAL4 AGND) vsource dc=0 type=dc
VCALU5 (BITU_CAL5 AGND) vsource dc=0 type=dc
VCALU6 (BITU_CAL6 AGND) vsource dc=0 type=dc
VCALU7 (BITU_CAL7 AGND) vsource dc=0 type=dc
VCALU8 (BITU_CAL8 AGND) vsource dc=0 type=dc
VCALU9 (BITU_CAL9 AGND) vsource dc=0 type=dc
VCALU10 (BITU_CAL10 AGND) vsource dc=0 type=dc
VCALU11 (BITU_CAL11 AGND) vsource dc=0 type=dc
VCALU12 (BITU_CAL12 AGND) vsource dc=0 type=dc

XSW (AGND AVDD BITD1 BITD2 BITD3 BITD4 BITD5 BITD6 BITD7 BITD8 BITD9 BITD10 BITD11 BITD12 BITD13 \
    BITN0 BITN1 BITN2 BITN3 BITN4 BITN5 BITN6 BITN7 BITN8 BITN9 BITN10 BITN11 BITN12 BITN13 \
    BITP0 BITP1 BITP2 BITP3 BITP4 BITP5 BITP6 BITP7 BITP8 BITP9 BITP10 BITP11 BITP12 BITP13 \
    BITU1 BITU2 BITU3 BITU4 BITU5 BITU6 BITU7 BITU8 BITU9 BITU10 BITU11 BITU12 BITU13 N P RST RST1 \
    SET0 SET1 SET2 SET3 SET4 SET5 SET6 SET7 SET8 SET9 SET10 SET11 SET12 VCM VIN VIP VREFN VREFP \
    BITD_CAL0 BITD_CAL1 BITD_CAL2 BITD_CAL3 BITD_CAL4 BITD_CAL5 BITD_CAL6 BITD_CAL7 BITD_CAL8 BITD_CAL9 BITD_CAL10 BITD_CAL11 BITD_CAL12 \
    BITU_CAL0 BITU_CAL1 BITU_CAL2 BITU_CAL3 BITU_CAL4 BITU_CAL5 BITU_CAL6 BITU_CAL7 BITU_CAL8 BITU_CAL9 BITU_CAL10 BITU_CAL11 BITU_CAL12 \
    CAL CAL_CLK) SWITCH_CAL RON_SAMPLE=5 RON_REF=10 RON_TOP=5 ROFF=1e15 TD_RSTT=200p TD_RST11=200p NORMAL_REF_SWAP=1

XCDAC (BITD1 BITD2 BITD3 BITD4 BITD5 BITD6 BITD7 BITD8 BITD9 BITD10 BITD11 BITD12 BITD13 \
    BITU1 BITU2 BITU3 BITU4 BITU5 BITU6 BITU7 BITU8 BITU9 BITU10 BITU11 BITU12 BITU13 N P) CDAC_0716
XMON (MONCLK BITD1 BITD2 BITD3 BITD4 BITD5 BITD6 BITD7 BITD8 BITD9 BITD10 BITD11 BITD12 BITD13 \
    BITU1 BITU2 BITU3 BITU4 BITU5 BITU6 BITU7 BITU8 BITU9 BITU10 BITU11 BITU12 BITU13 AGND AVDD) SW_MON

tran tran stop=1.31u maxstep=1n annotate=status
save P N BITD1 BITD2 BITD3 BITD4 BITD5 BITD6 BITD7 BITD8 BITD9 BITD10 BITD11 BITD12 BITD13
saveOptions options save=selected

ahdl_include "SWITCH_CAL_original.va"
ahdl_include "SW_MON.va"
