  address = {南京},
  urldate = {2026-06-21},
  abstract = {随着无线通信、便携式测量仪器等方面的快速发展,要求模数转换器（Analog-to-Digital Converter,ADC）的速度越来越高、功耗越来越低。逐次逼近型（Successive Approximation Register,SAR）ADC具有结构简单、面积小、功耗低的天然优势,并且能够适应工艺尺寸缩小带来的挑战,不仅在低速低功耗应用领域占据着广阔的市场,在高速低功耗领域也逐渐崭露头角,因此,研究单核高速低功耗SAR ADC的实现技术具有重要意义。本课题对单核SAR ADC的设计进行研究,致力于在保证SAR ADC低功耗优势的基础上尽可能提高转换速度。本文调研了国内外SAR ADC的研究现状,分析了SAR ADC的几种常见结构及设计中的非理想因素,最终确定了适合本课题的设计方案。本次设计的SAR ADC包括采样开关、DAC电容阵列、比较器及失调校正模块、SAR控制逻辑电路。采用线性度高的栅压自举开关提高精度;采用改进型分段电容结构,去掉了低位段的最高位电容,有效地控制了面积和功耗,同时采用部分单调开关切换方案,在最高位和次高位比较时都不需要消耗能量,功耗比单调型时序方案减少了5...},
  collaborator = {{孟桥}},
  langid = {chinese},
  school = {东南大学},
  annotation = {Major: 电路与系统},
  file = {D:\Academic\Zotero\files\李晓兴 - 2019 - 高速低功耗逐次逼近型模数转换器研究.pdf}
}

@article{safiallah2023_Currentadjusting,
  title = {A Current-Adjusting Auto-Zeroing Technique for {{DC-offset}} and Flicker-Noise Cancellation},
  author = {Safiallah, Mahyar and Danesh, Ahmad Reza and Pu, Haoran and Heydari, Payam},
  year = 2023,
  month = dec,
  journal = {IEEE Transactions on Very Large Scale Integration (VLSI) Systems},
  volume = {31},
  number = {12},
  pages = {1950--1959},
  issn = {1557-9999},
  doi = {10.1109/TVLSI.2023.3311794},
  urldate = {2026-03-11},
  abstract = {This article presents a current-adjusting auto-zeroing (CAAZ) scheme that overcomes the critical shortcomings of state-of-the-art auto-zero-based offset and low-frequency noise cancellation methods. The proposed technique appropriately adjusts the bias current of individual branches within the amplifier to cancel dc offset and low-frequency noise. The CAAZ method does not suffer from thermal-noise increase due to input signal division and stability issues encountered in input auto-zero (IAZ) or limited allowable gain and input swing experienced in the output auto-zero (OAZ) method. Moreover, it does not create any feedback loop during its operation phases and, thus, does not impose additional stability restrictions on the amplifier within which it is being used. Two differential amplifiers, a single-stage differential amplifier (SSDA) and a folded-cascode amplifier (FCA), employing the proposed CAAZ technique, are designed and simulated in a standard 180-nm CMOS process. Simulation results verify the higher performance of the proposed CAAZ compared to the conventional counterparts.},
  langid = {english},
  keywords = {Auto-zero (AZ) amplifier,auto-zero technique,Capacitors,dc-offset cancellation,Differential amplifiers,Logic gates,Low-frequency noise,Manganese,MOSFET,Voltage},
  file = {D:\Academic\Zotero\files\07_在读\Safiallah 等 - 2023 - A current-adjusting auto-zeroing technique for DC-offset and flicker-noise cancellation.pdf}
}

@phdthesis{ShenAo2026_GaoJingDuZhuCiBiJinXingMoShuZhuanHuanQiYanJiu,
  type = {{硕士学位论文}},
  title = {{高精度逐次逼近型模数转换器研究}},
  author = {{申奥}},
  year = 2026,
  month = jan,
  address = {南京},
  doi = {10.27014/d.cnki.gdnau.2024.005554},
  urldate = {2026-06-21},
  abstract = {模数转换器(ADC)作为将模拟世界信息转换为数字信息的关键模块,广泛应用于仪器测试、医疗电子、传感检测等领域。随着技术发展,市场对ADC的精度以及功耗提出更高的要求。逐次逼近型ADC(SAR ADC)因为其结构简单、高能效、兼容先进工艺等优势,在众多模数转换器中脱颖而出。设计一款符合工业应用场景的中速高精度SAR ADC具有一定的研究意义和实用价值。 本文对SAR ADC进行研究,调研了高精度SAR ADC以及其校准算法的国内外研究现状,分析影响SAR ADC精度的非理想因素。在总结现有校准技术的基础上,本文提出一种基于冗余分段电容的失调双注入LMS校准算法。采用变权重步长的方法优化迭代速度和精度;引入平均的策略抑制噪声对权重迭代影响;迭代部分权重位降低算法所需的数字消耗;引入小数段提升校准阶段的精度并增强工作阶段的静态性能。在此基础上,本文建立Matlab行为级模型验证上述校准算法的可行性,并将DNL优化到0.5LSB以内。接着完成各个子模块的设计,采用栅压自举开关,并控制衬底连接消除体效应,降低输入采样开关的非线性。DAC采用分段电容结构降低面积和功耗,加入3bit LMS注入段电容实现16～112LSB范围的固定失调量选择。比较器采用级联预放大锁存比较器,通过提高第一级功耗占比,降低等效输入噪声;通过采用OOS技术,有效降低输入失调;通过每级采用cascode结构,抑制回踢噪声。 本文在180nm CMOS工艺下完成16bit SAR ADC整体电路和版图的设计,版图内核部分面积为1mm\texttimes 1mm。整体后仿真最差工艺角结果显示:在采样率为1MSPS,输入信号频率接近20kHz幅度-0.5dBFS的情况下,ENOB为15.63bits,SFDR为105.6dB,FoMs为173.01dB;考虑采样噪声、量化噪声以及比较器噪声的影响后,ENOB为14.69bits,SFDR为100.1dB,FoMs为167.38dB,功耗为9.563mW。},
  collaborator = {{孟桥} and {刘海涛}},
  langid = {chinese},
  school = {东南大学},
  annotation = {Major: 电子信息（专业学位）},
  file = {D:\Academic\Zotero\files\申奥 - 2026 - 高精度逐次逼近型模数转换器研究.pdf}
}

@article{wang2026_00035mm2,
